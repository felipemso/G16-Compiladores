NO_PROGRAMA
├── NO_DECL_VAR let x
│   └── NO_NUMERO 0 [numero]
├── NO_IF
│   ├── condicao: NO_BOOLEANO true [booleano]
│   └── entao: NO_IF
│       ├── condicao: NO_BOOLEANO false [booleano]
│       ├── entao: NO_ATRIBUICAO x
│       │   └── NO_NUMERO 1 [numero]
│       └── senao: NO_ATRIBUICAO x
│           └── NO_NUMERO 2 [numero]
├── NO_WHILE
│   ├── condicao: NO_BINARIO < [booleano]
│   │   ├── NO_ID x [numero]
│   │   └── NO_NUMERO 3 [numero]
│   └── corpo: NO_BLOCO
│       └── NO_ATRIBUICAO x
│           └── NO_BINARIO + [numero]
│               ├── NO_ID x [numero]
│               └── NO_NUMERO 1 [numero]
├── NO_FOR
│   ├── inicializacao: NO_DECL_VAR let i
│   │   └── NO_NUMERO 0 [numero]
│   ├── condicao: NO_BINARIO < [booleano]
│   │   ├── NO_ID i [numero]
│   │   └── NO_NUMERO 2 [numero]
│   ├── incremento: NO_ATRIBUICAO i
│   │   └── NO_BINARIO + [numero]
│   │       ├── NO_ID i [numero]
│   │       └── NO_NUMERO 1 [numero]
│   └── corpo: NO_BLOCO
│       └── NO_PRINT
│           └── NO_ID i [numero]
├── NO_FOR
│   └── corpo: NO_VAZIO
├── NO_FOR
│   ├── condicao: NO_BOOLEANO false [booleano]
│   └── corpo: NO_BLOCO
└── NO_FOR
    ├── inicializacao: NO_ATRIBUICAO x
    │   └── NO_NUMERO 0 [numero]
    ├── incremento: NO_BINARIO + [numero]
    │   ├── NO_ID x [numero]
    │   └── NO_NUMERO 1 [numero]
    └── corpo: NO_VAZIO

def _js_str(valor):
    if valor is None:
        return "undefined"
    if isinstance(valor, bool):
        return "true" if valor else "false"
    if isinstance(valor, float) and valor.is_integer() and abs(valor) < 1e21:
        return str(int(valor))
    return str(valor)


def _js_print(*valores):
    print(" ".join(_js_str(valor) for valor in valores))


def maior(a, b, c):
    if a >= b and a >= c:
        return a
    elif b >= c:
        return b
    else:
        return c
def descreve(a, b, c):
    m = maior(a, b, c)
    if m == a and m == b and m == c:
        _js_print(a, b, c, "-> todos iguais a", m)
    else:
        _js_print(a, b, c, "-> maior:", m)
descreve(3, 7, 5)
descreve(9, 2, 4)
descreve(1, 6, 8)
descreve(-1, -5, -3)
descreve(2.5, 2.25, 2)
descreve(4, 4, 4)

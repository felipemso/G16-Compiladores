def _js_str(valor):
    if valor is None:
        return "undefined"
    if isinstance(valor, bool):
        return "true" if valor else "false"
    if isinstance(valor, float) and valor.is_integer() and abs(valor) < 1e21:
        return str(int(valor))
    return str(valor)


def _js_print(*valores):
    print(" ".join(_js_str(valor) for valor in valores))


n = 5
def fatorial(n):
    if n <= 1:
        return 1
    return n * fatorial(n - 1)
def quadrado(x):
    return x * x
def soma_quadrados(a, b):
    return quadrado(a) + quadrado(b)
def maior(a, b):
    if a > b:
        return a
    return b
def vazia():
    pass
def sem_valor(x):
    if x:
        return
    x = not x
f = fatorial(n)
s = soma_quadrados(n, 2) - maior(f, 3)
vazia()
sem_valor(False)
_js_print(n, f, s, fatorial(0), maior(quadrado(3), fatorial(3)))

def _js_str(valor):
    if valor is None:
        return "undefined"
    if isinstance(valor, bool):
        return "true" if valor else "false"
    if isinstance(valor, float) and valor.is_integer() and abs(valor) < 1e21:
        return str(int(valor))
    return str(valor)


def _js_print(*valores):
    print(" ".join(_js_str(valor) for valor in valores))


def soma_ate(n):
    soma = 0
    i = 1
    while i <= n:
        soma = soma + i
        i = i + 1
    return soma
def gauss(n):
    return n * (n + 1) / 2
N = 100
resultado = soma_ate(N)
_js_print("soma de 1 a", N, "=", resultado)
_js_print("formula de Gauss:", gauss(N))
_js_print("iguais:", resultado == gauss(N))
_js_print("soma de 1 a 7 =", soma_ate(7), "e media", soma_ate(7) / 7)

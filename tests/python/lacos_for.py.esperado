def _js_str(valor):
    if valor is None:
        return "undefined"
    if isinstance(valor, bool):
        return "true" if valor else "false"
    if isinstance(valor, float) and valor.is_integer() and abs(valor) < 1e21:
        return str(int(valor))
    return str(valor)


def _js_print(*valores):
    print(" ".join(_js_str(valor) for valor in valores))


soma = 0
i = 1
while i <= 5:
    soma = soma + i
    i = i + 1
pares = 0
a = 0
b = 6
while a < b:
    pares = pares + 1
    a = a + 1
k = 0
while k < 4:
    k = k + 1
passos = 0
m = 0
while m < 3:
    passos = passos + 2
    m = m + 1
while False:
    pass
def soma_grade(linhas, colunas):
    total = 0
    lin = 0
    while lin < linhas:
        col = 0
        while col < colunas:
            total = total + 1
            col = col + 1
        lin = lin + 1
    return total
def conta_ate(alvo):
    p = 0
    while True:
        if p == alvo:
            return p
        p = p + 1
_js_print(soma, pares, k, passos, soma_grade(3, 4), conta_ate(5))

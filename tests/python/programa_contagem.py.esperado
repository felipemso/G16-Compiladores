def _js_str(valor):
    if valor is None:
        return "undefined"
    if isinstance(valor, bool):
        return "true" if valor else "false"
    if isinstance(valor, float) and valor.is_integer() and abs(valor) < 1e21:
        return str(int(valor))
    return str(valor)


def _js_print(*valores):
    print(" ".join(_js_str(valor) for valor in valores))


nome = "Mini-JS"
versao = 1.5
ativo = True
indefinido = None
_js_print("compilador:", nome, "versao", versao, "ativo:", ativo, "valor:", indefinido)
pares = 0
impares = 0
eh_impar = True
i = 1
while i <= 20:
    if eh_impar:
        impares = impares + 1
    else:
        pares = pares + 1
    eh_impar = not eh_impar
    i = i + 1
_js_print("pares:", pares, "impares:", impares, "total:", pares + impares)
_js_print(10 / 2, 7 / 2, 1 / 4, -3 * 2)
_js_print("vazio:", "", "fim")
_js_print(pares > impares, pares == impares, not ativo)
_js_print()

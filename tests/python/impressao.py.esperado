def _js_str(valor):
    if valor is None:
        return "undefined"
    if isinstance(valor, bool):
        return "true" if valor else "false"
    if isinstance(valor, float) and valor.is_integer() and abs(valor) < 1e21:
        return str(int(valor))
    return str(valor)


def _js_print(*valores):
    print(" ".join(_js_str(valor) for valor in valores))


inteiro = 42
negativo = -7
real = 3.5
divisao = 10 / 4
exata = 9 / 3
texto = "ola"
vazio = ''
ligado = True
desligado = False
indefinido = None
def nada():
    return
_js_print(inteiro, negativo, real, divisao, exata)
_js_print(texto, vazio, texto + " mundo")
_js_print(ligado, desligado, inteiro > real, not ligado)
_js_print(indefinido, nada())
_js_print(0.1 + 0.2, 1000000 * 1000000, 2.5 * 2)
_js_print()
_js_print("total:", inteiro + real, "ok:", ligado and inteiro == 42)
